{
  "name": "retrolink",
  "version": "0.1.0",
  "description": "Retro multiplayer launcher",
  "author": "Capitan Meque",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "electron": "electron .",
    "electron2": "electron . --user-data-dir=./electron-profile-2",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && electron-builder"
  },
  "dependencies": {
    "nat-upnp": "^1.1.1",
    "network": "^0.7.0",
    "node-datachannel": "^0.25.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.retrolink.app",
    "productName": "RetroLink",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
